void Main_Release_Mouse(U8 Key_Matrix_Num){
	
    #if (SUPPORT_MAC_BOOT_AND_DOS_MODE)
 	if (g_USBCore_Setting.EP0_DosMode)
 	{
		switch(g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1])
		{
			case 0xf0:
				 g_Main_Setting.MouseInReport[0] &=~ 0x01;
				break;
			case 0xf1:
				 g_Main_Setting.MouseInReport[0] &=~ 0x02;
				break;
			case 0xf2:
				 g_Main_Setting.MouseInReport[0] &=~ 0x04;
				break;
            case 0xf8: //(Add)Abellee 20121123 fix SW4,SW5 bug
                //#if (SUPPORT_MAC_OS_PAGE_UP_DN_KEY)
				if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                //#endif//SUPPORT_MAC_OS_PAGE_UP_DN_KEY
                {
				    g_Main_Setting.MouseInReport[0] &=~ 0x08;
                }
				break;

            case 0xf9:
                //#if (SUPPORT_MAC_OS_PAGE_UP_DN_KEY)
				if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                //#endif//SUPPORT_MAC_OS_PAGE_UP_DN_KEY
                {
				    g_Main_Setting.MouseInReport[0] &=~ 0x10;
                }
				break;
			default:
				g_Main_Setting.MouseInReport[0] = 0;
				break;
		}
 	}
	else
    #endif
	 {
		g_Main_Setting.MouseInReport[0] = 0x01;
		switch(g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1])
		{
			case 0xf0:
				 g_Main_Setting.MouseInReport[1] &=~ 0x01;
				break;
			case 0xf1:
				 g_Main_Setting.MouseInReport[1] &=~ 0x02;
				break;
			case 0xf2:
				 g_Main_Setting.MouseInReport[1] &=~ 0x04;
				break;

            case 0xf8: //(Add)Abellee 20121123 fix SW4,SW5 bug
                //#if (SUPPORT_MAC_OS_PAGE_UP_DN_KEY)
				if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                //#endif//SUPPORT_MAC_OS_PAGE_UP_DN_KEY
                {
				    g_Main_Setting.MouseInReport[1] &=~ 0x08;
                }
				break;

            case 0xf9:
                //#if (SUPPORT_MAC_OS_PAGE_UP_DN_KEY)
				if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                //#endif//SUPPORT_MAC_OS_PAGE_UP_DN_KEY
                {
				    g_Main_Setting.MouseInReport[1] &=~ 0x10;
                }
				break;
			default:
				g_Main_Setting.MouseInReport[1] = 0;
				break;
		}
 	}

	g_Main_Setting.MouseInReport[6] = 0;
	g_Main_Setting.MouseInReport[7] = 0;
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
	g_Repot_Process.Mouse_Report_In = 1;
}

