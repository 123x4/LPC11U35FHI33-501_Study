void Main_Zoon_In(void){
	g_Main_Setting.KeyboardInReport[GIdx0] = 0x01;		//Ctrl key
	g_Repot_Process.Keyboard_Report_In = 1;
	//nsAPI_Main_KeyboardInReportHandler();
	while(g_Repot_Process.Keyboard_Report_In==1){
		nsAPI_Main_KeyboardInReportHandler();
	}
	g_Main_Setting.MouseInReport[0] = 0x01;		//Mouse report ID
	g_Main_Setting.MouseInReport[6] = QIE_BACKWARD;		//Scroll
	g_Repot_Process.Mouse_Report_In = 1;
	//nsAPI_Main_MouseInReportHandler();
	while(g_Repot_Process.Mouse_Report_In==1){
		nsAPI_Main_MouseInReportHandler();
	}

	g_Main_Setting.KeyboardInReport[GIdx0] = 0x00;		//Release
	g_Repot_Process.Keyboard_Report_In = 1;				//Ctrl Key release
	//nsAPI_Main_KeyboardInReportHandler();
	while(g_Repot_Process.Keyboard_Report_In==1){
		nsAPI_Main_KeyboardInReportHandler();
	}
}

void Main_Zoon_Out(void){
	g_Main_Setting.KeyboardInReport[GIdx0] = 0x01;		//Ctrl key
	g_Repot_Process.Keyboard_Report_In = 1;
	//nsAPI_Main_KeyboardInReportHandler();
	while(g_Repot_Process.Keyboard_Report_In==1){
		nsAPI_Main_KeyboardInReportHandler();
	}
	g_Main_Setting.MouseInReport[6] = QIE_FORWARD;		//Scroll
	g_Repot_Process.Mouse_Report_In = 1;
	//nsAPI_Main_MouseInReportHandler();
	while(g_Repot_Process.Mouse_Report_In==1){
		nsAPI_Main_MouseInReportHandler();
	}

	g_Main_Setting.KeyboardInReport[GIdx0] = 0x00;		//Release
	g_Repot_Process.Keyboard_Report_In = 1;				//Ctrl Key release
	//nsAPI_Main_KeyboardInReportHandler();
	while(g_Repot_Process.Keyboard_Report_In==1){
		nsAPI_Main_KeyboardInReportHandler();
	}
}

void Main_Fire_Key(U8 u8RepeatValue){
	unsigned char KeyRepeat;

	for(KeyRepeat = 0; KeyRepeat < u8RepeatValue; KeyRepeat++)
	{
		g_Main_Setting.MouseInReport[1] |= 0x01;	//Button L
		g_Repot_Process.Mouse_Report_In = 1;
		//nsAPI_Main_MouseInReportHandler();
		while(g_Repot_Process.Mouse_Report_In==1)
		{
			nsAPI_Main_MouseInReportHandler();
		}

		g_Repot_Process.Mouse_Report_In = 1;		//Release
		g_Main_Setting.MouseInReport[1] &= ~0x01;	// Release Button L
		//nsAPI_Main_MouseInReportHandler();
		while(g_Repot_Process.Mouse_Report_In==1){
			nsAPI_Main_MouseInReportHandler();
		}

	}
}
void Main_Launch_AP(void){
	U16	ID;
	ID = USB_VID;
	g_Main_Setting.ConsumerInReport[GIdx0] = 0x07;
	g_Main_Setting.ConsumerInReport[GIdx1] = 0xA3;
	g_Main_Setting.ConsumerInReport[GIdx2] = (ID>>8);
	g_Main_Setting.ConsumerInReport[GIdx3] = (ID&0xff);
	ID = USB_PID;
	g_Main_Setting.ConsumerInReport[GIdx4] = (ID>>8);
	g_Main_Setting.ConsumerInReport[GIdx5] = (ID&0xff);
	g_Main_Setting.ConsumerInReport[GIdx6] = 0;
	g_Main_Setting.ConsumerInReport[GIdx7] = 0;
	g_Repot_Process.Consumer_Report_In = 1;
}

