								 {
									 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+X_STAGE_OFFSET,&g_dMouse.SensorSetting.dbXDPILevelIndex,X_STAGE_SIZE);
									 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+Y_STAGE_OFFSET,&g_dMouse.SensorSetting.dbYDPILevelIndex,Y_STAGE_SIZE);
									 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+X_CURRENT_DPI_OFFSET,&g_dMouse.SensorSetting.dbXDPICrtValue,X_CURRENT_DPI_SIZE);
									 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+Y_CURRENT_DPI_OFFSET,&g_dMouse.SensorSetting.dbYDPICrtValue,Y_CURRENT_DPI_SIZE);
								 }
								 #endif
							 }
							 //g_USBCore_Setting.EP0_SetReq = 0; //Command finish
						  }
						 break;
						 case SM_EVENT6_SET_LED_COLOR:

							 g_dMouse.GeneralSetting.dbProfileIndex = g_Main_Setting.OutReport[GIdx2];
							 g_dMouse.GeneralSetting.dbLedArea=g_Main_Setting.OutReport[GIdx3];
							 g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].R=g_Main_Setting.OutReport[GIdx4];
							 g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].G=g_Main_Setting.OutReport[GIdx5];
							 g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].B=g_Main_Setting.OutReport[GIdx6];

							 #if 0
							 nsAPI_SSP_ADNS9800_Set_LEDColor(g_dMouse.GeneralSetting.dbLedArea,\
																  g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].R,\
																  g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].G,\
																  g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].B);
							 #endif
							 
							 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
							 {
								 //nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+AREA_1_LED_R_VALUE_OFFSET+(g_dMouse.GeneralSetting.dbLedArea*3),\
															(U8 *)&g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea],AREA_1_LED_R_VALUE_SIZE*3);
							 }
							 //g_USBCore_Setting.EP0_SetReq = 0; //Command finish
						 break;
						 case SM_EVENT6_SET_LED_PULSATIOM:
								 g_dMouse.GeneralSetting.dbProfileIndex = g_Main_Setting.OutReport[GIdx2];
							 g_dMouse.GeneralSetting.dbLedArea=g_Main_Setting.OutReport[GIdx3];
							 g_dMouse.GeneralSetting.dbLedPulsationEffect[g_dMouse.GeneralSetting.dbLedArea]=g_Main_Setting.OutReport[GIdx4];
							 //nsAPI_SSP_ADNS9800_Set_LEDPulsationEffect(g_dMouse.GeneralSetting.dbLedArea,\
																		 g_dMouse.GeneralSetting.dbLedPulsationEffect[g_dMouse.GeneralSetting.dbLedArea]);
							 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
							 {
								 //nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+AREA_1_LED_PULSATION_OFFSET+\
														 (g_dMouse.GeneralSetting.dbLedArea*1),&g_dMouse.GeneralSetting.dbLedPulsationEffect[g_dMouse.GeneralSetting.dbLedArea],AREA_1_LED_PULSATION_SIZE);
							 }
							 //g_USBCore_Setting.EP0_SetReq = 0; //Command finish
						 break;
						 case SM_EVENT6_SET_LED_INTENSITY:
							 g_dMouse.GeneralSetting.dbProfileIndex = g_Main_Setting.OutReport[GIdx2];
							 g_dMouse.GeneralSetting.dbLedArea=g_Main_Setting.OutReport[GIdx3];
							 g_dMouse.GeneralSetting.dbLedintensity[g_dMouse.GeneralSetting.dbLedArea]=g_Main_Setting.OutReport[GIdx4];
							 //nsAPI_SSP_ADNS9800_Set_LEDIntensity(g_Main_Setting.OutReport[GIdx3],g_Main_Setting.OutReport[GIdx4]);
							 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
							 {
								// nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+AREA_1_LED_INTENSITY_OFFSET+\
														 (g_dMouse.GeneralSetting.dbLedArea*1),&g_dMouse.GeneralSetting.dbLedintensity[g_dMouse.GeneralSetting.dbLedArea],AREA_1_LED_INTENSITY_SIZE);
							  }
							 //g_USBCore_Setting.EP0_SetReq = 0; //Command finish
						 break;
				 #if 0
						 case SM_EVENT6_SET_SENSOR_SROM:
						 {
							 U8 u8Temp;
							 g_Main_Setting.Total_Size =ADNS9800_SROM_TABLE_SIZE;
							 g_Main_Setting.ADR_Offset = 0;
							 g_StaticMachineEvent6Type = SM_EVENT6_SET_SENSOR_SROM; //Command not finish

						 #if 1
							 nsAPI_SSP_ADNS9800_Write(ADNS9800_CONFIGURATION_IV_ADDR,0x02);/*3K SROM Size*/
							 nsAPI_SSP_ADNS9800_Write(ADNS9800_SROM_ENABLE_ADDR,0x1D);/*SROM Enable*/
							 nsAPI_SSP_ADNS9800_Write(ADNS9800_SROM_ENABLE_ADDR,0x18);
							 NDrv_SSP_ADNS9800_SSEL(LOW);
							 u8Temp = (ADNS9800_SROM_LOAD_BURST_ADDR|0x80);
							 nsAPI_SSP_Send(&u8Temp,1);
						 #endif
						 }
						 break;
				 #endif
				 #if 0
						 case SM_EVENT6_SET_SENSITIVITY:
							 g_dMouse.GeneralSetting.dbProfileIndex = g_Main_Setting.OutReport[GIdx2];
							 g_dMouse.SensorSetting.dbXSensitivity=g_Main_Setting.OutReport[GIdx3];
							 g_dMouse.SensorSetting.dbYSensitivity=g_Main_Setting.OutReport[GIdx4];

							 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
							 {
								 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+\
															 X_SENSITIVITY_OFFSET,&g_dMouse.SensorSetting.dbXSensitivity,X_SENSITIVITY_SIZE);
								 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+\
															 Y_SENSITIVITY_OFFSET,&g_dMouse.SensorSetting.dbYSensitivity,Y_SENSITIVITY_SIZE);
							 }
							 //g_USBCore_Setting.EP0_SetReq = 0; //Command finish
						 break;
				 #endif

						 case SM_EVENT6_SET_ANGLE_SNAPPING:
							 g_dMouse.GeneralSetting.dbProfileIndex = g_Main_Setting.OutReport[GIdx2];
							 g_dMouse.SensorSetting.dbAngleSnapping=g_Main_Setting.OutReport[GIdx3];
							 //nsAPI_SSP_ADNS9800_Set_AngleSnapping(g_Main_Setting.OutReport[GIdx3]);
							 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
							 {
								// nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+ANGLE_SNAPPING_OFFSET,\
															 &g_dMouse.SensorSetting.dbAngleSnapping,ANGLE_SNAPPING_SIZE);
							 }
							 //g_USBCore_Setting.EP0_SetReq = 0; //Command finish
						 break;
						 case SM_EVENT6_SET_LIFT_DETECTION:
							 g_dMouse.GeneralSetting.dbProfileIndex = g_Main_Setting.OutReport[GIdx2];
							 g_dMouse.SensorSetting.dbLiftDetection=g_Main_Setting.OutReport[GIdx3];
							 //nsAPI_SSP_ADNS9800_Set_LeftDetection(g_Main_Setting.OutReport[GIdx3]);
							 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
							 {
								// nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+LIFT_DETECTION_OFFSET,\
															&g_dMouse.SensorSetting.dbLiftDetection,LIFT_DETECTION_SIZE);
							 }
							 //g_USBCore_Setting.EP0_SetReq = 0; //Command finish
						 break;
                         case SM_EVENT6_SET_OS_MODE: //Bit[0]: Window ,Bit[1]:MAC //0x00 => non-Know OS , 0x01:Window , 0x02:MAC
                            g_Main_Setting.OS_ModeType = g_Main_Setting.OutReport[GIdx2];
                            break;
						 case SM_EVENT6_UPDATE_FIRMWARE: //BootLoader
							 i = BL_UPGRADE;
							// nsAPI_I2C_Write_Database(RM_BOOTLOADER_STATUS_ADR,&i,1);	 //Update firmware notice
						 #if 0
							 WDT_CLK_Setup(1);
							 WDTInit();
							 while(1);
						 #else
                             NDrv_USB_Connect(FALSE);//(Add)Abellee 20131126 Add USB DisConnect
                             NDrv_USB_Reset(); //(Add)Abellee 20131126 Add USB Reset
                             //nsAPI_SSP_Sensor_Delsyms(5);
							 NVIC_SystemReset();
						 #endif

						 //break;
					 }
				 break;
				 default:
				 break;
			 }
		 break;

		 case SM_EVENT6_SET_KEY_MATRIX:
		 {
			 U8 Key_Loop,Key_Number;
			 Key_Number = 7-g_Main_Setting.Total_Size;
			 Key_Number *= 2;
			 for(Key_Loop = 0; Key_Loop < KEY_MATRIX_LEN; Key_Loop++){
				 g_Key_Matrix[Key_Number].Key_Assignment[Key_Loop] = g_Main_Setting.OutReport[Key_Loop];
				 g_Key_Matrix[Key_Number+1].Key_Assignment[Key_Loop] = g_Main_Setting.OutReport[Key_Loop+KEY_MATRIX_LEN];
			 }
			 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
			 {
				// nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+KEY_MATRIX_OFFSET+g_Main_Setting.ADR_Offset,&g_Main_Setting.OutReport[0],8);
			 }
			 g_Main_Setting.Total_Size -= 1;
			 g_Main_Setting.ADR_Offset += 8;

			 if(g_Main_Setting.Total_Size  == 0){
				 g_StaticMachineEvent6Type = SM_EVENT6_IDLE;
			 }
		 }
		 break;

		 case SM_EVENT6_SET_MACRO:
		 {
			 U8 Data_Pos;
			 Data_Pos=0;
			 while(Data_Pos < 8){
				 if((g_Main_Setting.Total_Size% 122)==0){
					 g_Macro_Key[g_Set_Matrix.Key_Group].Repeat_Count = g_Main_Setting.OutReport[Data_Pos];
					 Data_Pos++;
					 g_Macro_Key[g_Set_Matrix.Key_Group].Repeat_Count *= 256;
					 g_Macro_Key[g_Set_Matrix.Key_Group].Repeat_Count += g_Main_Setting.OutReport[Data_Pos];
					 g_Main_Setting.Total_Size--;
				 }
				 else{
					 switch(g_Set_Matrix.M_Data_Byte){
						 case 0:
							 g_Macro_Key[g_Set_Matrix.Key_Group].Key_Attr[g_Set_Matrix.Action].u16Value = (U16)(g_Main_Setting.OutReport[Data_Pos]<<8);
							 g_Set_Matrix.M_Data_Byte++;
						 break;
						 case 1:
							 g_Macro_Key[g_Set_Matrix.Key_Group].Key_Attr[g_Set_Matrix.Action].u16Value += g_Main_Setting.OutReport[Data_Pos];
							 g_Set_Matrix.M_Data_Byte++;
						 break;
						 case 2:
							 g_Macro_Key[g_Set_Matrix.Key_Group].KeyCode[g_Set_Matrix.Action] = g_Main_Setting.OutReport[Data_Pos];
							 g_Set_Matrix.Action++;
							 if(g_Set_Matrix.Action>=40){
								 g_Set_Matrix.Action = 0;
								 g_Set_Matrix.Key_Group++;
								 if(g_Set_Matrix.Key_Group >= 14){
									 g_Set_Matrix.Key_Group=0;
								 }
							 }
							 g_Set_Matrix.M_Data_Byte = 0;
						 break;
					 }

				 }

				 if(g_Main_Setting.Total_Size >0)
					 g_Main_Setting.Total_Size--;

				 if(g_Main_Setting.Total_Size  ==0)
					 Data_Pos=8;

				 Data_Pos++;
			 }

		 #if 0 //(ENABLE_UART)
			 xprintf("\r\n S=%d",g_Main_Setting.Total_Size);
			 xprintf("\r\n G=%d ",g_Set_Matrix.Key_Group);
			 xprintf("\r\n O=%d ",g_Main_Setting.ADR_Offset);
		 #endif

			 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
			 {
				 //if(g_Main_Setting.Total_Size ==0)
				//	 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+MARCO_TABLE_OFFSET+g_Main_Setting.ADR_Offset,&g_Main_Setting.OutReport[0],4);
				// else
				//	 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+MARCO_TABLE_OFFSET+g_Main_Setting.ADR_Offset,&g_Main_Setting.OutReport[0],8);
			 }

			 if(g_Main_Setting.Total_Size ==0)
			 {
				 g_StaticMachineEvent6Type = SM_EVENT6_IDLE;
			 }

			 g_Main_Setting.ADR_Offset += 8;
		 }
		 break;

#if 0
		 case SM_EVENT6_SET_SENSOR_SROM:
		 {
			 U8 i;

			 if(g_Main_Setting.Total_Size > 8){
				 nsAPI_I2C_Write_Database(RM_SENSOR_SROM_EEPROM_ADR+g_Main_Setting.ADR_Offset,g_Main_Setting.OutReport,8);
				 //nsAPI_I2C_Write_Database(RM_SENSOR_SROM_EEPROM_ADR+g_Main_Setting.ADR_Offset,/*g_Main_Setting.OutReport*/(U8 *)&ADNS9800_SROM_Table[0]+g_Main_Setting.ADR_Offset,8);
				 for (i =0 ; i < 8 ; i++)
				 {
					 nsAPI_SSP_Send((U8 *)&g_Main_Setting.OutReport[0]+i, 1);
					 //nsAPI_SSP_Send((U8 *)&ADNS9800_SROM_Table[0]+g_Main_Setting.ADR_Offset+i, 1);
				 }

				 g_Main_Setting.Total_Size -= 8;

				 if(g_Main_Setting.Total_Size  == 0){
					 g_StaticMachineEvent6Type = SM_EVENT6_IDLE;
				 }
			 }
			 else{

				 nsAPI_I2C_Write_Database(RM_SENSOR_SROM_EEPROM_ADR+g_Main_Setting.ADR_Offset,g_Main_Setting.OutReport,6);
				 //nsAPI_I2C_Write_Database(RM_SENSOR_SROM_EEPROM_ADR+g_Main_Setting.ADR_Offset,(U8 *)&ADNS9800_SROM_Table[0]+g_Main_Setting.ADR_Offset,6);
				 for (i =0 ; i < 6 ; i++)
				 {
					 nsAPI_SSP_Send((U8 *)&g_Main_Setting.OutReport[0]+i, 1);
					 //nsAPI_SSP_Send((U8 *)&ADNS9800_SROM_Table[0]+g_Main_Setting.ADR_Offset+i, 1);
				 }

			 #if 1
				 NDrv_SSP_ADNS9800_SSEL(HIGH);
				 nsAPI_SSP_Sensor_Delsyus(180);/*180us*/
			 #endif

				 g_Main_Setting.Total_Size = 0;
				 g_StaticMachineEvent6Type = SM_EVENT6_IDLE;
			 }

			 g_Main_Setting.ADR_Offset += 8;
		 }
		 break;
 #endif

		 case SM_EVENT6_SET_DPI:
		 {
			 if(g_Main_Setting.Total_Size > 1)
			 {
				 for(i =0 ; i < 8 ; i ++)
				 {
					 g_dMouse.SensorSetting.dbXDPILevel[i]=g_Main_Setting.OutReport[i];
				 }

				 //nsAPI_SSP_Switch_DPILevel();

				 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
				 {
				//	 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+X_DPI_SET_OFFSET,\
												 &g_dMouse.SensorSetting.dbXDPILevel[0],X_DPI_SET_SIZE);
				 }
				 g_Main_Setting.Total_Size --;
				 //if(g_Main_Setting.Total_Size  == 0)
					 //g_StaticMachineEvent6Type = SM_EVENT6_IDLE;
			 }
			 else
			 {
				 for(i =0 ; i < 8 ; i ++)
				 {
					 g_dMouse.SensorSetting.dbYDPILevel[i]=g_Main_Setting.OutReport[i];
				 }

				 if(g_dMouse.GeneralSetting.dbProfileIndex>0)
				 {
				//	 nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+Y_DPI_SET_OFFSET,\
												 &g_dMouse.SensorSetting.dbYDPILevel[0],Y_DPI_SET_SIZE);
				  }

				 #if 0
				 nsAPI_SSP_Set_Sensor_X_Resolution(7,TRUE); //current DPI
				 nsAPI_SSP_Set_Sensor_Y_Resolution(7,TRUE); //current DPI
				 #else
				 g_dMouse.SensorSetting.dbDPIStage=7; //current DPI
				// nsAPI_SSP_Set_Sensor_X_Resolution(g_dMouse.SensorSetting.dbDPIStage,TRUE);
				 //nsAPI_SSP_Set_Sensor_Y_Resolution(g_dMouse.SensorSetting.dbDPIStage,TRUE);
				 g_dMouse.SensorSetting.dbXDPICrtValue = (g_dMouse.SensorSetting.dbXDPILevel[g_dMouse.SensorSetting.dbDPIStage])&0x7F;
				 g_dMouse.SensorSetting.dbYDPICrtValue = (g_dMouse.SensorSetting.dbYDPILevel[g_dMouse.SensorSetting.dbDPIStage])&0x7F;
				 #endif
				 g_StaticMachineEvent6Type = SM_EVENT6_IDLE;
				 g_Main_Setting.Total_Size = 0;
			 }
		 }
		 break;
	 #if 0
		 case SM_EVENT6_SET_MACRO_STOP_MODE:
			 g_Main_Setting.MacroStopMode = g_Main_Setting.OutReport[GIdx3];
		 break;
	 #endif
	 }

}

void Mapp_StaticMachineEvent7(void)
{
	switch(g_StaticMachineEvent7Type)
	{
		case SM_EVENT7_IDLE:
			g_USBCore_Setting.EP0_GetReq = 0;
		break;
		
		case SM_EVENT7_GET_FIRMWAVE_VERSION:
		g_USBCore_Setting.EP0Buf[GIdx1] = (PRODUCT_ID & 0x00F0) >> 4;
		g_USBCore_Setting.EP0Buf[GIdx2] = (PRODUCT_ID & 0x000F) >> 0;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;

		case SM_EVENT7_GET_REPORT_RATE:
		g_USBCore_Setting.EP0Buf[GIdx1] =g_dMouse.SensorSetting.dbReportRate;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;

		case SM_EVENT7_GET_CURRENT_PROFILE:
		//g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;

		case SM_EVENT7_GET_DPI:
			switch(g_Main_Setting.Total_Size){
				U8 Data_Loop;
				case 2:
					for(Data_Loop = 0;Data_Loop<8;Data_Loop++){
						g_Main_Setting.ConsumerInReport[Data_Loop] = g_dMouse.SensorSetting.dbXDPILevel[Data_Loop];
					}

					//nsAPI_SSP_Switch_DPILevel();
					if(g_Repot_Process.Consumer_Report_In == 0){		//Check EP3 Status
						g_Repot_Process.Consumer_Report_In =1;
						g_Main_Setting.Total_Size --;
					}
				break;
				case 1:
					for(Data_Loop = 0;Data_Loop<8;Data_Loop++){
						g_Main_Setting.ConsumerInReport[Data_Loop] = g_dMouse.SensorSetting.dbYDPILevel[Data_Loop];
					}
					if(g_Repot_Process.Consumer_Report_In == 0){		//Check EP3 Status
						g_Repot_Process.Consumer_Report_In = 1;
						g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
						g_Main_Setting.Total_Size=0;
					}
				break;

			}

		#if PC_AP_DELAY
			nsAPI_SSP_Sensor_Delsyms(20);
		#endif
		break;

		case SM_EVENT7_GET_DPI_Stage:
		//g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_dMouse.SensorSetting.dbDPIStage;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;

	#if 0
		case SM_EVENT7_GET_MACRO_STOP_MODE:
		g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_Main_Setting.MacroStopMode;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;
	#endif

		case SM_EVENT7_GET_LED_COLOR:
		//g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_dMouse.GeneralSetting.dbLedArea;
		g_USBCore_Setting.EP0Buf[GIdx3] =g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].R;
		g_USBCore_Setting.EP0Buf[GIdx4] =g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].G;
		g_USBCore_Setting.EP0Buf[GIdx5] =g_dMouse.GeneralSetting.dbLedColor[g_dMouse.GeneralSetting.dbLedArea].B;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;

		case SM_EVENT7_GET_LED_INTENSITY:
		//g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_dMouse.GeneralSetting.dbLedArea;
		g_USBCore_Setting.EP0Buf[GIdx3] =g_dMouse.GeneralSetting.dbLedintensity[g_dMouse.GeneralSetting.dbLedArea];
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;

		case SM_EVENT7_GET_LED_PULSATION_EFFECT:
		//g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_dMouse.GeneralSetting.dbLedArea;
		g_USBCore_Setting.EP0Buf[GIdx3] =g_dMouse.GeneralSetting.dbLedPulsationEffect[g_dMouse.GeneralSetting.dbLedArea];
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;
	#if 0 //no use
		case SM_EVENT7_GET_X_Y_SENSITIVITY:
		g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_dMouse.SensorSetting.dbXSensitivity;
		g_USBCore_Setting.EP0Buf[GIdx3] =g_dMouse.SensorSetting.dbYSensitivity;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;
	#endif
		case SM_EVENT7_GET_SENSOR_STATUS:
		g_USBCore_Setting.EP0Buf[GIdx1] =g_dMouse.SensorSetting.dbSensorStatus;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;
		case SM_EVENT7_GET_ANGLE_SNAPPING:
		//g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_dMouse.SensorSetting.dbAngleSnapping;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;

		case SM_EVENT7_GET_LIFT_DETECTION:
		//g_USBCore_Setting.EP0Buf[GIdx1] =nsAPI_Database_Button_Get_ProfileGroup_Index();
		g_USBCore_Setting.EP0Buf[GIdx2] =g_dMouse.SensorSetting.dbLiftDetection;
		EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
		break;
        case SM_EVENT7_GET_OS_MODE:
        g_USBCore_Setting.EP0Buf[GIdx1] = g_Main_Setting.OS_ModeType;
        g_USBCore_Setting.EP0Buf[GIdx2] = 0;
        EP0_Send();
		g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
        break;
		case SM_EVENT7_GET_KEY_MATRIX:
		{
			U8 Data_Loop;
			if(g_Repot_Process.Consumer_Report_In == 0){		//Check EP3 Status
				for(Data_Loop = 0;Data_Loop<KEY_MATRIX_LEN;Data_Loop++){
					g_Main_Setting.ConsumerInReport[Data_Loop] = g_Key_Matrix[(14-2*g_Main_Setting.Total_Size)].Key_Assignment[Data_Loop];
					g_Main_Setting.ConsumerInReport[Data_Loop+KEY_MATRIX_LEN] = g_Key_Matrix[(15-2*g_Main_Setting.Total_Size)].Key_Assignment[Data_Loop];
				}
				g_Repot_Process.Consumer_Report_In = 1;
				g_Main_Setting.Total_Size -= 1;
			}

		#if PC_AP_DELAY
			nsAPI_SSP_Sensor_Delsyms(25);
		#endif

			if( g_Main_Setting.Total_Size == 0){
				g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
			}
		}
		break;
	#if 0
		case SM_EVENT7_GET_SENSOR_SROM:
			{
				if(g_Repot_Process.Consumer_Report_In == 0){	//Check EP3 Status

					nsAPI_I2C_Read_Database(RM_SENSOR_SROM_EEPROM_ADR+g_Main_Setting.ADR_Offset,g_Main_Setting.ConsumerInReport ,CONSUMER_IN_REPORT_SIZE);

					if(g_Main_Setting.Total_Size==1)
					{
						g_Main_Setting.ConsumerInReport[6]=0x00;
						g_Main_Setting.ConsumerInReport[7]=0x00;
					}

					g_Repot_Process.Consumer_Report_In = 1;
					g_Main_Setting.Total_Size -= 1;
				}
				g_Main_Setting.ADR_Offset += 8;

				if( g_Main_Setting.Total_Size == 0){
					g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
				}
			}
		break;
	#endif
		case SM_EVENT7_GET_MARCO_KEY:
			{
				U8 Data_Pos;
				Data_Pos=0;

				if(g_Repot_Process.Consumer_Report_In == 0){	//Check EP3 Status

					while(Data_Pos < 8)
					{
						if((g_Main_Setting.Total_Size% 122)==0)
						{
							g_Main_Setting.ConsumerInReport[Data_Pos]=((g_Macro_Key[g_Set_Matrix.Key_Group].Repeat_Count &0xff00)>>8);
							Data_Pos++;
							g_Main_Setting.ConsumerInReport[Data_Pos]=(g_Macro_Key[g_Set_Matrix.Key_Group].Repeat_Count & 0x00ff);
							g_Main_Setting.Total_Size--;
						}
						else
						{
							switch(g_Set_Matrix.M_Data_Byte)
							{
								case 0:
									g_Main_Setting.ConsumerInReport[Data_Pos]=((g_Macro_Key[g_Set_Matrix.Key_Group].Key_Attr[g_Set_Matrix.Action].u16Value)>>8);
									g_Set_Matrix.M_Data_Byte++;
									break;
								case 1:
									g_Main_Setting.ConsumerInReport[Data_Pos]=(g_Macro_Key[g_Set_Matrix.Key_Group].Key_Attr[g_Set_Matrix.Action].u16Value & 0x00ff);
									g_Set_Matrix.M_Data_Byte++;
									break;
								case 2:
									g_Main_Setting.ConsumerInReport[Data_Pos]=g_Macro_Key[g_Set_Matrix.Key_Group].KeyCode[g_Set_Matrix.Action] ;
									g_Set_Matrix.Action++;
									if(g_Set_Matrix.Action>=40){
										g_Set_Matrix.Action = 0;
										g_Set_Matrix.Key_Group++;
										if(g_Set_Matrix.Key_Group >=14 ){
											g_Set_Matrix.Key_Group=0;
										}
									}
									g_Set_Matrix.M_Data_Byte = 0;
									break;
							}

						}

						if(g_Main_Setting.Total_Size >0)
							g_Main_Setting.Total_Size--;

						if(g_Main_Setting.Total_Size ==0)
							Data_Pos=8;

						Data_Pos++;

					 }


					if(g_Main_Setting.Total_Size==0)
					{
						g_Main_Setting.ConsumerInReport[4]=0x00;
						g_Main_Setting.ConsumerInReport[5]=0x00;
						g_Main_Setting.ConsumerInReport[6]=0x00;
						g_Main_Setting.ConsumerInReport[7]=0x00;
					}

					g_Repot_Process.Consumer_Report_In = 1;
				}

			#if PC_AP_DELAY
				nsAPI_SSP_Sensor_Delsyms(20);
			#endif

				if( g_Main_Setting.Total_Size ==0)
				{
					g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
				}
			}
		break;
	#if 0
		case SM_EVENT7_GET_FLASH_INFO:
			{
				if(g_Repot_Process.Consumer_Report_In == 0){	//Check EP3 Status

					nsAPI_I2C_Read_Database(RM_FLASH_INFO_ADR+g_Main_Setting.ADR_Offset,g_Main_Setting.ConsumerInReport ,CONSUMER_IN_REPORT_SIZE);
					g_Repot_Process.Consumer_Report_In = 1;
					g_Main_Setting.Total_Size -= 1;
				}
				g_Main_Setting.ADR_Offset += 8;

				if( g_Main_Setting.Total_Size == 0){
					g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
				}
			}
		break;
	#endif
		default:
			g_StaticMachineEvent7Type=SM_EVENT7_IDLE;
			break;
	}

}
#endif
