	g_Main_Setting.SystemInReport[GIdx0] = 0x02;		//Report ID
	g_Main_Setting.SystemInReport[GIdx1] = g_Key_Matrix[Key_Matrix_Num].Key_Assignment[2];
	g_Main_Setting.SystemInReport[GIdx2] = 0;		//0
