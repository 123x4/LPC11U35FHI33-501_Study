void Main_Consumer_Loader_Clr(void)
{
	nsAPI_Main_Clr_ConsumerEvent();
	g_Repot_Process.Consumer_Report_In = 1;
}

void Main_DPI_Loader_Ready(U8 u8DPISwitch,U8 u8DPIStage ,U8 u8DPIValue)
{
	g_Main_Setting.ConsumerInReport[GIdx0] = 0x07;
	g_Main_Setting.ConsumerInReport[GIdx1] = 0x41;
	g_Main_Setting.ConsumerInReport[GIdx2] = g_dMouse.GeneralSetting.dbProfileIndex;
	g_Main_Setting.ConsumerInReport[GIdx3] = u8DPISwitch ;//0x06:DPI_Y,0x07:DPI_W,0xF0:DPI_SW
	g_Main_Setting.ConsumerInReport[GIdx4] = u8DPIStage;//AP Index0~5 , 6:Snipper , 7:Current DPI
	g_Main_Setting.ConsumerInReport[GIdx5] = u8DPIValue;
	g_Main_Setting.ConsumerInReport[GIdx6] = 0;
	g_Main_Setting.ConsumerInReport[GIdx7] = 0;
	g_Repot_Process.Consumer_Report_In = 1;

	if(g_Repot_Process.Consumer_Report_In == 1)
		nsAPI_Main_ConsumerInReportHandler();

	Main_Consumer_Loader_Clr();
}

void Main_Send_Keyboard(U8 Key_Matrix_Num){
	g_Main_Setting.KeyboardInReport[GIdx0] = 0;		//Function key
	g_Main_Setting.KeyboardInReport[GIdx1] = 0;		//Always 0x00
	g_Main_Setting.KeyboardInReport[GIdx2] = g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1];		//Keycode
	g_Main_Setting.KeyboardInReport[GIdx3] = 0;		//Keycode
	g_Main_Setting.KeyboardInReport[GIdx4] = 0;		//Keycode
	//g_Main_Setting.KeyboardInReport[GIdx5] = 0;		//Keycode
	//g_Main_Setting.KeyboardInReport[GIdx6] = 0;		//Keycode
	//g_Main_Setting.KeyboardInReport[GIdx7] = 0;		//Keycode
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
	g_Repot_Process.Keyboard_Report_In = 1;
}

void Main_Media_Loader_Ready(U8 u8Byte1, U8 u8Byte2 ,U8 u8Byte3, U8 u8Byte4)
{
	g_Main_Setting.ConsumerInReport[GIdx0] = 0x07;
	g_Main_Setting.ConsumerInReport[GIdx1] = 0x42 ;
	g_Main_Setting.ConsumerInReport[GIdx2] = g_dMouse.GeneralSetting.dbProfileIndex;
	g_Main_Setting.ConsumerInReport[GIdx3] = u8Byte1;//MODE_MEDIA
	g_Main_Setting.ConsumerInReport[GIdx4] = u8Byte2;
	g_Main_Setting.ConsumerInReport[GIdx5] = u8Byte3;
	g_Main_Setting.ConsumerInReport[GIdx6] = u8Byte4;
	g_Main_Setting.ConsumerInReport[GIdx7] = 0;
	g_Repot_Process.Consumer_Report_In = 1;

    while(g_Repot_Process.Consumer_Report_In == 1){
		nsAPI_Main_ConsumerInReportHandler();
    }
	//Main_Consumer_Loader_Clr();
}

