	g_Main_Setting.SystemInReport[GIdx7] = 0;		//0
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
	g_Repot_Process.System_Report_In = 1;
}

void Main_Send_Mouse(U8 Key_Matrix_Num){
    #if  (SUPPORT_MAC_BOOT_AND_DOS_MODE)
	if (g_USBCore_Setting.EP0_DosMode)
	{
		switch(g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1]){
			case 0xf0:
				g_Main_Setting.MouseInReport[0] |= 0x01;		//Button L
			break;
			case 0xf1:
				g_Main_Setting.MouseInReport[0] |= 0x02;		//Button M
			break;
			case 0xf2:
				g_Main_Setting.MouseInReport[0] |= 0x04;		//Button R
			break;
			case 0xf3:
				g_Main_Setting.MouseInReport[5] = QIE_FORWARD;		//Scroll
			break;
			case 0xf4:
				g_Main_Setting.MouseInReport[5] = QIE_BACKWARD;		//Scroll
			break;
			case 0xf5:
				g_Main_Setting.MouseInReport[6] = 0xff;
			break;
			case 0xf6:
				g_Main_Setting.MouseInReport[6] = 0x01;
			break;
			case 0xf8:
                if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                {
				    g_Main_Setting.MouseInReport[0] |= 0x08;		//Button 4 //page up
                }
			break;
			case 0xf9:

				if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                {
				    g_Main_Setting.MouseInReport[0] |= 0x10;		//Button 5 //page dn
                }

			break;
		}
	}
	else
    #endif //(SUPPORT_MAC_BOOT_AND_DOS_MODE)
	{
		switch(g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1]){
			case 0xf0:
				g_Main_Setting.MouseInReport[1] |= 0x01;		//Button L
			break;
			case 0xf1:
				g_Main_Setting.MouseInReport[1] |= 0x02;		//Button M
			break;
			case 0xf2:
				g_Main_Setting.MouseInReport[1] |= 0x04;		//Button R
			break;
			case 0xf3:
				g_Main_Setting.MouseInReport[6] = QIE_FORWARD;		//Scroll
			break;
			case 0xf4:
				g_Main_Setting.MouseInReport[6] = QIE_BACKWARD;		//Scroll
			break;
			case 0xf5:
				g_Main_Setting.MouseInReport[7] = 0xff;
			break;
			case 0xf6:
				g_Main_Setting.MouseInReport[7] = 0x01;
			break;
			case 0xf8:
				if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                {
				    g_Main_Setting.MouseInReport[1] |= 0x08;		//Button 4 //page up
                }
			break;
			case 0xf9:
				if(g_Main_Setting.OS_ModeType == WINDOW_OS_MODE)
                {
				    g_Main_Setting.MouseInReport[1] |= 0x10;		//Button 5 //page dn
                }

			break;
		}
		g_Main_Setting.MouseInReport[0] = 0x01;		//Mouse report ID
	}

	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
	g_Repot_Process.Mouse_Report_In = 1;
}

void Main_Process_DPI(U8 Key_Matrix_Num){
	switch(g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1]){
		case 0x06:
			g_GpioKeyboard.Y_DPI_Press = 1;
			//nsAPI_SSP_ADNS9800_Next_YResolution();
		break;
		case 0x07:
			g_GpioKeyboard.X_DPI_Press = 1;
			//nsAPI_SSP_ADNS9800_Next_XResolution();
		break;
		case 0xf0:
			//nsAPI_SSP_ADNS9800_Next_XYResolution();
			//nsAPI_SSP_ADNS9800_Next_LED_XYResolution();
		       g_dMouse.SensorSetting.dbXDPICrtValue =(g_dMouse.SensorSetting.dbXDPILevel[g_dMouse.SensorSetting.dbDPIStage])&0x7F;
		       g_dMouse.SensorSetting.dbYDPICrtValue =(g_dMouse.SensorSetting.dbYDPILevel[g_dMouse.SensorSetting.dbDPIStage])&0x7F;
			Main_DPI_Loader_Ready(g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1],g_dMouse.SensorSetting.dbDPIStage,0);
		break;
		case 0x08: //DPI Snipper
			//nsAPI_SSP_Set_Sensor_X_Resolution(6,TRUE);
			//nsAPI_SSP_Set_Sensor_Y_Resolution(6,TRUE);
			Main_DPI_Loader_Ready(g_Key_Matrix[Key_Matrix_Num].Key_Assignment[1],6,0);
		break;
	}
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;

}
void Main_Release_Keyboard(U8 Key_Matrix_Num){
	g_Main_Setting.KeyboardInReport[GIdx0] = 0;		//Function key
	g_Main_Setting.KeyboardInReport[GIdx1] = 0;		//Always 0x00
	g_Main_Setting.KeyboardInReport[GIdx2] = 0;		//Keycode
	g_Main_Setting.KeyboardInReport[GIdx3] = 0;		//Keycode
	g_Main_Setting.KeyboardInReport[GIdx4] = 0;		//Keycode
	g_Main_Setting.KeyboardInReport[GIdx5] = 0;		//Keycode
	g_Main_Setting.KeyboardInReport[GIdx6] = 0;		//Keycode
	g_Main_Setting.KeyboardInReport[GIdx7] = 0;		//Keycode
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
	g_Repot_Process.Keyboard_Report_In = 1;
}
