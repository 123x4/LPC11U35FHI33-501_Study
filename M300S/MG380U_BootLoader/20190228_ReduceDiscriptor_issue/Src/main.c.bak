void nsAPI_Main_MouseInReportHandler(void)
{
	S_Y_Sleep_ReCheck();

	#if REMOTE_WAKEUP_ENABLE
	if ( rSuspendFlag == 1 ) 
	{
		rSuspendFlag = 0;
		
		///------	
		
		//S_PWM_Enable();
		//S_PWM_Enable_WakeUp();	
		S_PWM_INIT();
		//S_ADN9800_INIT_ValueReset();	//2016_0517_Hsiang
		nsAPI_Sensor_Init();
		
		
		///------	
		
		RemoteWakeupEvent();
		g_Main_Setting.SensorReset = 1;
		g_Repot_Process.Mouse_Report_In = 0;
