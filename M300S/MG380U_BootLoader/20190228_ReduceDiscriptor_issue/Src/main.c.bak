	g_Main_Setting.MediaInReport[GIdx1] = g_Key_Matrix[Key_Matrix_Num].Key_Assignment[3];
	g_Main_Setting.MediaInReport[GIdx2] = g_Key_Matrix[Key_Matrix_Num].Key_Assignment[2];
	g_Main_Setting.MediaInReport[GIdx3] = 0;		//Keycode
	g_Main_Setting.MediaInReport[GIdx4] = 0;		//Keycode
	g_Main_Setting.MediaInReport[GIdx5] = 0;		//Keycode
	g_Main_Setting.MediaInReport[GIdx6] = 0;		//Keycode
	g_Main_Setting.MediaInReport[GIdx7] = 0;		//Keycode
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
	g_Repot_Process.Media_Report_In = 1;
}

