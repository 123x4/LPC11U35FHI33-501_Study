							if(g_StaticMachineEvent3Type != SM_EVENT3_MACRO_HANDLER){
								g_Key_Matrix_Attr.KeyTableNum = g_Key_Matrix[13].Key_Assignment[3];
								g_Key_Matrix_Attr.KeyLoop = g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Repeat_Count;
								g_Key_Matrix_Attr.DecKeyLoop= g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Repeat_Count;
								g_Key_Matrix_Attr.KeyAction = 0;
								g_Key_Matrix_Attr.KeyDelay = 0;
								g_Key_Matrix_Attr.fKeyDelay = 0;
								g_StaticMachineEvent3Type = SM_EVENT3_MACRO_HANDLER;	//Enable macro key sending

							}
							else{
								g_StaticMachineEvent3Type = SM_EVENT3_IDLE;

							}
						break;
					}

				}
			}
///------------------------------------------------------------ Temp 13
#endif
			
			g_StaticMachineEvent2Type = SM_EVENT2_IDLE;
		}
		break;
///================================================================== KeyScan
		case SM_EVENT2_IDLE:
			if(g_Sensor_Data.Changed == 1){
				nsAPI_Main_MouseInReportHandler();
			}
		default:
		break;
	}

}
#endif

#ifdef M_Macro_Key
void Mapp_StaticMachineEvent3(void)
{
	switch(g_StaticMachineEvent3Type)
	{
		case SM_EVENT3_MACRO_HANDLER:
			MacroKey_Handler();
		break;

		case SM_EVENT3_IDLE:
			if (u8MarcoKeyIn)
			{
				MarcoKey_Release_Key();
			}
		default:
		break;
	}
}
#endif

