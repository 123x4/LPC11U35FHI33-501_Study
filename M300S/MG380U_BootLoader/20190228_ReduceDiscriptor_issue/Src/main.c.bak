void Mapp_StaticMachineEvent2(void)
{
	switch(g_StaticMachineEvent2Type)		//Button handle
	{
		case SM_EVENT2_BUTTON_HANDLER:
		{

			
///------------------------------------------------------------------------	
#if 0
			//S_KeyScsan_UpUSBReport();
		
#endif	
///------------------------------------------------------------------------	
#if 0
///------------------------------------------------------------------------			
			U8 Key_Loop;

			for(Key_Loop = 0;Key_Loop<12;Key_Loop++){
				if(g_Key_Matrix[Key_Loop].Changed==1){
					//xprintf("Key_IN:0x%x",g_Key_Matrix[Key_Loop].Key_Assignment[0]);

                    if(g_Key_Matrix[Key_Loop].Key_Assignment[0]==MODE_MOUSE)
                    {
                        U8 j;
                        switch(g_Key_Matrix[Key_Loop].Key_Assignment[1]){

                            case 0xf8://[ //forward //0x2f //page up
                                if(g_Main_Setting.OS_ModeType == MAC_OS_MODE)
                                {
                                    g_Key_Matrix[Key_Loop].Key_Assignment[0] = MODE_MACRO;        //Button 4 //page up
                                    g_Key_Matrix[Key_Loop].Key_Assignment[3] = KEY_MAC_OS_NUM-1;
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Repeat_Count = 1;  //repeat time

                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[0].bit.Press = 1;           //Press
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[0].bit.Delay = 40;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[0] = 0xE3;
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[1].bit.Press = 1;       //Release
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[1].bit.Delay = 40;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[1] = 0x2F;

                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[2].bit.Press = 0;           //Press
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[2].bit.Delay = 20;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[2] = 0x2F;
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[3].bit.Press = 0;       //Release
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[3].bit.Delay = 20;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[3] = 0xE3;

                            		for ( j = 4 ; j <40 ; j++)
                            		{
                            			g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[j].u16Value = 0; //Release //Timebase = 0ms
                            			g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[j] = 0;
                            		}

                                }
                            break;
                            case 0xf9://] // backward //0x30 //page down
                                if(g_Main_Setting.OS_ModeType == MAC_OS_MODE)
                                {
                                    g_Key_Matrix[Key_Loop].Key_Assignment[0] = MODE_MACRO;        //Button 5 //page up
                                    g_Key_Matrix[Key_Loop].Key_Assignment[3] = KEY_MAC_OS_NUM-1;
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Repeat_Count = 1;  //repeat time

                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[0].bit.Press = 1;           //Press
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[0].bit.Delay = 40;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[0] = 0xE3;
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[1].bit.Press = 1;       //Release
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[1].bit.Delay = 40;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[1] = 0x30;

                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[2].bit.Press = 0;           //Press
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[2].bit.Delay = 20;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[2] = 0x30;
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[3].bit.Press = 0;       //Release
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[3].bit.Delay = 20;      //Timebase = 20ms
                                    g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[3] = 0xE3;

                                    for ( j = 4 ; j <40 ; j++)
                            		{
                            			g_Macro_Key[KEY_MAC_OS_NUM-1].Key_Attr[j].u16Value = 0; //Release //Timebase = 0ms
                            			g_Macro_Key[KEY_MAC_OS_NUM-1].KeyCode[j] = 0;
                            		}

                                }
                            break;
                        }

                    }

		///--------------------------------------------------------------------
					switch(g_Key_Matrix[Key_Loop].Key_Assignment[0]){
						case MODE_KEYBOARD:
							if(g_Key_Matrix[Key_Loop].Press){
								Main_Send_Keyboard(Key_Loop);
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}
							}
							else{
								Main_Release_Keyboard(Key_Loop);
							}
						break;
						case MODE_MOUSE:
							
							if(g_Key_Matrix[Key_Loop].Press){
								Main_Send_Mouse(Key_Loop);
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}
							}
							else{
								Main_Release_Mouse(Key_Loop);
							}
							
						break;
						case MODE_SYSTEM:
							if(g_Key_Matrix[Key_Loop].Press){
								Main_Send_System(Key_Loop);
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}
							}
							else{
								Main_Release_System(Key_Loop);
							}
						break;
						case MODE_MEDIA:
							if(g_Key_Matrix[Key_Loop].Press){
								Main_Send_Media(Key_Loop);
								Main_Media_Loader_Ready(g_Key_Matrix[Key_Loop].Key_Assignment[0],g_Key_Matrix[Key_Loop].Key_Assignment[1],\
														    g_Key_Matrix[Key_Loop].Key_Assignment[2],g_Key_Matrix[Key_Loop].Key_Assignment[3]);
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}
							}
							else{
								Main_Release_Media(Key_Loop);
								Main_Consumer_Loader_Clr();
							}
						break;
						case MODE_SHORTCUT:
							if(g_Key_Matrix[Key_Loop].Press){
								Main_Send_ShortCut(Key_Loop);
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}
							}
							else{
								Main_Release_Keyboard(Key_Loop);
							}
						break;
						case MODE_DPI:
							if(g_Key_Matrix[Key_Loop].Press){
								Main_Process_DPI(Key_Loop);
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}
							}
							else{
								if(g_Key_Matrix[Key_Loop].Key_Assignment[1] == 0x07){
									g_GpioKeyboard.X_DPI_Press = 0;
								}
								if(g_Key_Matrix[Key_Loop].Key_Assignment[1] == 0x06){
									g_GpioKeyboard.Y_DPI_Press = 0;
								}
								if(g_Key_Matrix[Key_Loop].Key_Assignment[1] == 0x08){ //return DPI_SW

									//nsAPI_SSP_ADNS9800_Next_LED_XYResolution();
									nsAPI_SSP_Set_Sensor_XY_Resolution();
								       g_dMouse.SensorSetting.dbXDPICrtValue = (g_dMouse.SensorSetting.dbXDPILevel[g_dMouse.SensorSetting.dbDPIStage])&0x7F;
								       g_dMouse.SensorSetting.dbYDPICrtValue = (g_dMouse.SensorSetting.dbYDPILevel[g_dMouse.SensorSetting.dbDPIStage])&0x7F;
								}
								g_Key_Matrix[Key_Loop].Changed = 0;
							}
						break;

						case MODE_PROFILE_SWITCH:
							if(g_Key_Matrix[Key_Loop].Press){
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}

								Main_Process_Profile(g_Key_Matrix[Key_Loop].Key_Assignment[1]);
								Main_DPI_Loader_Ready(0,0,0);
							}
						break;
						case MODE_INSTANT_PROFILE:
							if(g_Key_Matrix[Key_Loop].Press){
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_Instant_Key.u8InstantKyeEnable==0)
									{
										if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
											g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
											g_Key_Matrix[Key_Loop].Changed = 0;
											break;
										}

										g_Instant_Key.u8InstantProfile = g_dMouse.GeneralSetting.dbProfileIndex;
										g_Instant_Key.u8InstantKyeNum = Key_Loop ;
										g_Instant_Key.u8InstantKyeEnable = 1 ;
										Main_Process_Profile(g_Key_Matrix[Key_Loop].Key_Assignment[1]);
										Main_DPI_Loader_Ready(0,0,0);

									}
								}

							}
							else
							{
								if(g_Instant_Key.u8InstantKyeEnable)
								{

									if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
										if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
											g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
											//g_Key_Matrix[Key_Loop].Changed = 0;
											//break;
										}
									}

									g_Instant_Key.u8InstantKyeEnable = 0 ;
									g_Instant_Key.u8InstantKyeNum = 0xFF ;
									Main_Process_Profile(g_Instant_Key.u8InstantProfile);
									Main_DPI_Loader_Ready(0,0,0);

								}
							}
						break;

						case MODE_SPECIAL:
							if(g_Key_Matrix[Key_Loop].Press){
								if(g_Main_Setting.MacroStopMode == MACRO_PRESS_ANY){
									if(g_StaticMachineEvent3Type == SM_EVENT3_MACRO_HANDLER){
										g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
										g_Key_Matrix[Key_Loop].Changed = 0;
										break;
									}
								}
								switch(g_Key_Matrix[Key_Loop].Key_Assignment[3]){
									case 0x20:
										Main_Zoon_In();
									break;
									case 0x21:
										Main_Zoon_Out();
									break;
									case 0x22:
										Main_Fire_Key(g_Key_Matrix[Key_Loop].Key_Assignment[2]);
									break;
									case 0x23:
										Main_Launch_AP();
									break;
								}
								g_Key_Matrix[Key_Loop].Changed = 0;
							}
						break;
						case MODE_MACRO:
							if(g_Key_Matrix[Key_Loop].Press){
								if(g_StaticMachineEvent3Type != SM_EVENT3_MACRO_HANDLER){
									g_Key_Matrix_Attr.KeyTableNum = g_Key_Matrix[Key_Loop].Key_Assignment[3];
									g_Key_Matrix_Attr.KeyLoop = g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Repeat_Count;
									g_Key_Matrix_Attr.DecKeyLoop= g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Repeat_Count;
									g_Key_Matrix_Attr.KeyAction = 0;
									g_Key_Matrix_Attr.KeyDelay = 0;
									g_Key_Matrix_Attr.fKeyDelay = 0;
									g_StaticMachineEvent3Type = SM_EVENT3_MACRO_HANDLER;	//Enable macro key sending

								}
								else{
									g_StaticMachineEvent3Type = SM_EVENT3_IDLE;

								}
								g_Key_Matrix[Key_Loop].Changed = 0;
							}
							else{
							#if 0
								if(g_Main_Setting.MacroStopMode == MACRO_RELEASE_KEY){
									g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
								}
							#endif
								//Check macro stop mode

							}

						break;
					}
				}
			}
///------------------------------------------------------------ Temp 1
