	g_Main_Setting.MediaInReport[0] = 0x03;
	g_Main_Setting.MediaInReport[1] = 0;
	g_Main_Setting.MediaInReport[2] = 0;
	g_Main_Setting.MediaInReport[3] = 0;
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
	g_Repot_Process.Media_Report_In = 1;
}

void Main_Release_System(U8 Key_Matrix_Num){
	g_Main_Setting.SystemInReport[0] = 0x02;
	g_Main_Setting.SystemInReport[1] = 0;
	g_Main_Setting.SystemInReport[2] = 0;
	g_Main_Setting.SystemInReport[3] = 0;
	g_Key_Matrix[Key_Matrix_Num].Changed = 0;
