								 //nsAPI_I2C_Write_Database(RM_PROFILE_0_START_ADR+(RM_PROFILE_LEN*(g_dMouse.GeneralSetting.dbProfileIndex-1))+DPI_STAGE_OFFSET,&g_dMouse.SensorSetting.dbDPIStage,DPI_STAGE_SIZE);
								 #if 0
