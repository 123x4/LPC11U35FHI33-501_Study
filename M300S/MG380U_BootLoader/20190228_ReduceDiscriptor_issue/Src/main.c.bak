	}
#else

	g_Main_Setting.FeatureInReport[GIdx0] = 0x07;//Report ID

	if(nsAPI_USB_EP_Status(HID_EP1_IN))//if((g_Main_Setting.EPInOutReq & EP1_IN) == EP1_IN)  //modify 20120808
	{

	#if 1
							
		nsAPI_USB_WriteEP(HID_EP1_IN,&g_Main_Setting.FeatureInReport[0],8);			
				
		nsAPI_Main_Clr_EP1Event();
		
		g_Main_Setting.EPInOutReq &= ~EP1_IN;
		
		g_Repot_Process.Feature_Report_In = 0;
	#else

		if(F_S_ReturnFeatureIn ==1){

			nsAPI_USB_WriteEP(HID_EP1_IN,&g_Main_Setting.FeatureInReport[8],8);			
				
			nsAPI_Main_Clr_EP1Event();
		
			g_Main_Setting.EPInOutReq &= ~EP1_IN;

			F_S_ReturnFeatureIn--;
			
		}
		else{

			nsAPI_USB_WriteEP(HID_EP1_IN,&g_Main_Setting.FeatureInReport[0],8);			
				
			nsAPI_Main_Clr_EP1Event();
		
			g_Main_Setting.EPInOutReq &= ~EP1_IN;
		
			g_Repot_Process.Feature_Report_In = 0;			
		}

		
	#endif
		
	}


#endif




#else

	g_USBCore_Setting.EP0Buf[0] = 0x07;		// Report ID
	g_USBCore_Setting.EP0Buf[1] = 0xab;
	g_USBCore_Setting.EP0Buf[2] = 0xcd;

	EP0_Send();

	g_Repot_Process.Feature_Report_In = 0;
	
#endif
	
}

//======================================================================
// ASUS command process
//----------------------------------------------------------------
void ASUS_command_process(void)				// hawk
{
	U32 cnt,i;
	cnt = nsAPI_USB_ReadEP(HID_EP4_OUT, g_USBCore_Setting.EP0Buf);

	for(i = 0;i < cnt; i++)
	{
		g_Main_Setting.InReport[i] = g_USBCore_Setting.EP0Buf[i];
		g_USBCore_Setting.EP0Buf[i] = 0;
	}

	if(cnt > CUSTOMER_IN_REPORT_SIZE)
		cnt = CUSTOMER_IN_REPORT_SIZE;
	
	 if(nsAPI_USB_EP_Status(HID_EP3_IN))	//if((g_Main_Setting.EPInOutReq & EP1_IN) == EP1_IN)  //modify 20120808
	{	
		nsAPI_USB_WriteEP(HID_EP3_IN, g_Main_Setting.InReport, cnt);
		nsAPI_Main_Clr_EP3Event();
		g_Main_Setting.EPInOutReq &= ~EP3_IN;
	}


}



