	g_Main_Setting.ShortcutInReport[GIdx0] = 0;		//Function key
	g_Main_Setting.ShortcutInReport[GIdx1] = 0;		//Always 0x00
	g_Main_Setting.ShortcutInReport[GIdx2] = 0;		//Keycode
	g_Main_Setting.ShortcutInReport[GIdx3] = 0;		//Keycode
	g_Main_Setting.ShortcutInReport[GIdx4] = 0;		//Keycode
	g_Main_Setting.ShortcutInReport[GIdx5] = 0;		//Keycode
	g_Main_Setting.ShortcutInReport[GIdx6] = 0;		//Keycode
