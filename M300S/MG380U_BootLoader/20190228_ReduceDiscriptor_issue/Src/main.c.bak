			g_Main_Setting.MouseInReport[GIdx4] = 0;
		}
	}
	else
	#endif //SUPPORT_MAC_BOOT_AND_DOS_MODE
	{
		g_Main_Setting.MouseInReport[GIdx0] = 0x01;//Report ID
