void nsAPI_Main_Clr_EP1Event(void)
{
	//org size is 8 byte, 2016_0608 become 6 byte and remove id
	/*
	if(g_Main_Setting.MouseInReport[GIdx0] != 1)
	{
		g_Main_Setting.MouseInReport[GIdx0] = 0;
		g_Main_Setting.MouseInReport[GIdx1] = 0;
	}
	else
	*/
	{
		g_Main_Setting.MouseInReport[GIdx1] = 0;
		g_Main_Setting.MouseInReport[GIdx2] = 0;
		g_Main_Setting.MouseInReport[GIdx3] = 0;
		g_Main_Setting.MouseInReport[GIdx4] = 0;
		g_Main_Setting.MouseInReport[GIdx5] = 0;
		//g_Main_Setting.MouseInReport[GIdx7] = 0;
	}

}

void nsAPI_Main_Clr_KeyboardEvent(void)
{
	g_Main_Setting.KeyboardInReport[GIdx0] = 1;
	g_Main_Setting.KeyboardInReport[GIdx1] = 0;
	g_Main_Setting.KeyboardInReport[GIdx2] = 0;
	g_Main_Setting.KeyboardInReport[GIdx3] = 0;
	g_Main_Setting.KeyboardInReport[GIdx4] = 0;
	g_Main_Setting.KeyboardInReport[GIdx5] = 0;
	g_Main_Setting.KeyboardInReport[GIdx6] = 0;
	g_Main_Setting.KeyboardInReport[GIdx7] = 0;
	g_Main_Setting.KeyboardInReport[GIdx8] = 0;	
}

void nsAPI_Main_Clr_ConsumerEvent(void)
{
	g_Main_Setting.ConsumerInReport[GIdx0] = 2;
	g_Main_Setting.ConsumerInReport[GIdx1] = 0;
	g_Main_Setting.ConsumerInReport[GIdx2] = 0;
//	g_Main_Setting.ConsumerInReport[GIdx3] = 0;   //hawk
//	g_Main_Setting.ConsumerInReport[GIdx4] = 0;   //hawk
//	g_Main_Setting.ConsumerInReport[GIdx5] = 0;   //hawk
//	g_Main_Setting.ConsumerInReport[GIdx6] = 0;   //hawk
//	g_Main_Setting.ConsumerInReport[GIdx7] = 0;   //hawk
}

void nsAPI_Main_Clr_EP3Event(void)      // hawk
{
	U8 i;

	for(i=0;i<CUSTOMER_IN_REPORT_SIZE;i++)
		g_Main_Setting.InReport[i] = 0;
}

#ifdef M_Macro_Key
void MacroKey_Handler(){
	U8 Temp;

		#if 0
		U16 u16Delay;
		if ( g_Key_Matrix_Attr.KeyAction==0)
			u16Delay =0;
		else
			u16Delay = (g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction-1].bit.Delay)
		#endif

		if( g_Key_Matrix_Attr.KeyDelay >= (g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Delay)){	//Timebase = 2* 10ms
			//g_Key_Matrix_Attr.KeyDelay = g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Delay;//Keep delay time, don't overflow
		           #if 0
				xprintf("\r\nKeyTableNum[%x],",g_Key_Matrix_Attr.KeyTableNum);
				xprintf("act[%x],",g_Key_Matrix_Attr.KeyAction);
				xprintf("Keycode[%x],",g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction]);
				xprintf("Press[%x],",g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Press);
				xprintf("Delay = [%d]", (g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Delay));
			    #endif

			if((g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Press)==1){ //Press or not
			    u8MarcoKeyIn =1;
				//xprintf("%x,",g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Press);
				//xprintf("%x,",g_Macro_Key[0].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Press);

				if(g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] >= 0xE0 && g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] <= 0xE7){
					Temp = g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] - 0xE0;
					g_Main_Setting.KeyboardInReport[GIdx0] |= 1<<Temp;
				}
				else{
					for(Temp = 2;Temp<8;Temp++){
						if(g_Main_Setting.KeyboardInReport[Temp] == 0){
							g_Main_Setting.KeyboardInReport[Temp] = g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction];
							break;
						}
					}
				}
			}
			//else send break;
			else{
				if(g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] >= 0xE0 && g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] <= 0xE7){
					Temp = g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] - 0xE0;
					g_Main_Setting.KeyboardInReport[GIdx0] &= 0xfe<<Temp;
				}
				else{
					for(Temp = 2;Temp<8;Temp++){
						if(g_Main_Setting.KeyboardInReport[Temp] == g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction]){
							g_Main_Setting.KeyboardInReport[Temp] = 0;
							break;
						}
					}
				}
			}

			g_Repot_Process.Macro_Keyboard_Report_In = 1;
			nsAPI_Main_MacroKeyInReportHandler();
			while(g_Repot_Process.Macro_Keyboard_Report_In==1){
			nsAPI_Main_MacroKeyInReportHandler();
			}

			g_Key_Matrix_Attr.KeyAction++;
			if(g_Key_Matrix_Attr.KeyAction < MAX_MACRO_ACTION)
			{
				while((g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] &0x7f) ==0x00)
				{
					g_Key_Matrix_Attr.KeyAction++;
					if(g_Key_Matrix_Attr.KeyAction <= MAX_MACRO_ACTION)
						continue;
					else
						break;
				}
			}

			if(g_Key_Matrix_Attr.KeyAction >= MAX_MACRO_ACTION){

				 if((g_Key_Matrix_Attr.KeyLoop >1)&&(g_Key_Matrix_Attr.DecKeyLoop >1))
				{
					g_Key_Matrix_Attr.KeyAction = 0;
					g_Key_Matrix_Attr.DecKeyLoop--;
					g_Key_Matrix_Attr.KeyDelay = 0;
					g_Key_Matrix_Attr.fKeyDelay = 0;
				}
				else
				{

					if(g_Key_Matrix_Attr.KeyLoop ==0)
					{
						g_Key_Matrix_Attr.KeyAction = 0;
						g_Key_Matrix_Attr.KeyDelay = 0;
						g_Key_Matrix_Attr.fKeyDelay = 0;
					}
					else
					{
						//Clear Macrokey flag
						MarcoKey_Release_Key();
						g_StaticMachineEvent3Type = SM_EVENT3_IDLE;
					}

				}
			}
			g_Key_Matrix_Attr.KeyDelay = 0;
			g_Key_Matrix_Attr.fKeyDelay = 0;
		}
}


void MarcoKey_Release_Key(void)
{
	U8 Temp;
	g_Key_Matrix_Attr.KeyDelay = 0;
	g_Key_Matrix_Attr.fKeyDelay = 0;
	g_Key_Matrix_Attr.DecKeyLoop =0;

    for (g_Key_Matrix_Attr.KeyAction =0; g_Key_Matrix_Attr.KeyAction < MAX_MACRO_ACTION ;g_Key_Matrix_Attr.KeyAction++)
    {
        if((g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Press)==1)
        { //0 is Press Key

			//xprintf("%x,",g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Press);
			//xprintf("%x,",g_Key_Matrix_Attr.KeyAction);
			//xprintf("%x,",g_Macro_Key[0].Key_Attr[g_Key_Matrix_Attr.KeyAction].bit.Press);
			if(g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] >= 0xE0 && g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] <= 0xE7)
            		{
				Temp = g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction] - 0xE0;
				g_Main_Setting.KeyboardInReport[GIdx0] &= 0xfe<<Temp;
			}
			else
            		{
				for(Temp = 2;Temp<8;Temp++)
               		{
					if(g_Main_Setting.KeyboardInReport[Temp] == g_Macro_Key[g_Key_Matrix_Attr.KeyTableNum].KeyCode[g_Key_Matrix_Attr.KeyAction])
                    			{
						g_Main_Setting.KeyboardInReport[Temp] = 0;
						break;
					}
				}
			}

			g_Repot_Process.Macro_Keyboard_Report_In = 1;
			nsAPI_Main_MacroKeyInReportHandler();
			while(g_Repot_Process.Macro_Keyboard_Report_In==1)
           		 {
				nsAPI_Main_MacroKeyInReportHandler();
            		}
        }

    }
    u8MarcoKeyIn =0;
    g_Key_Matrix_Attr.KeyAction =0;
}

#endif

