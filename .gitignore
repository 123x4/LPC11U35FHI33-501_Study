# Keep build outputs (including List/, output/, bin/ and obj/) tracked
# so remote AI tools can inspect firmware, maps, listings and build logs.

# Other files and folders
.settings/

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.

# Keil local UI state and backups
*.uvgui.*
*.uvguix.*
*.bak
JLinkLog.txt
JLinkSettings.ini
